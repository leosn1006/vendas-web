# ========================================
# CONFIGURAÇÕES DO WHATSAPP BUSINESS API
# ========================================

# Token de acesso do WhatsApp Business API (conta principal)
WHATSAPP_TOKEN=seu_token_aqui

# Contas adicionais WhatsApp Business
# O nome da variável é configurado por número na tabela telefones_produto (coluna token_env_key)
# IMPORTANTE: use apenas letras, números e underscores — hífens não funcionam no bash/compose
WHATSAPP_ACCESS_TOKEN_LSN=token_da_conta_lsn
WHATSAPP_ACCESS_TOKEN_LSSD=token_da_conta_lssd
WHATSAPP_ACCESS_TOKEN_LSDS=token_da_conta_lsds
WHATSAPP_ACCESS_TOKEN_KPN=token_da_conta_kpn
WHATSAPP_ACCESS_TOKEN_JU=token_da_conta_ju
WHATSAPP_ACCESS_TOKEN_LBE=token_da_conta_lbe
WHATSAPP_ACCESS_TOKEN_LB=token_da_conta_lb
WHATSAPP_ACCESS_TOKEN_BREP=token_da_conta_brep
WHATSAPP_ACCESS_TOKEN_LEITURAEMAIS=token_da_conta_leituraemais
WHATSAPP_ACCESS_TOKEN_LIVRINHOS=token_da_conta_livrinhos

# ID do número de telefone do WhatsApp Business
PHONE_NUMBER_ID=974838442380155

# Secret da aplicação para validação de webhooks
WHATSAPP_APP_SECRET=seu_app_secret_aqui
WHATSAPP_APP_SECRET_LSDS=app_secret_da_conta_lsds
WHATSAPP_APP_SECRET_KPN=app_secret_da_conta_kpn
WHATSAPP_APP_SECRET_JU=app_secret_da_conta_ju
WHATSAPP_APP_SECRET_LBE=app_secret_da_conta_lbe
WHATSAPP_APP_SECRET_LB=app_secret_da_conta_lb
WHATSAPP_APP_SECRET_BREP=app_secret_da_conta_brep
WHATSAPP_APP_SECRET_LEITURAEMAIS=app_secret_da_conta_leituraemais
WHATSAPP_APP_SECRET_LIVRINHOS=app_secret_da_conta_livrinhos

# Token de verificação do webhook
WHATSAPP_VERIFY_TOKEN=seu_verify_token_aqui

# ========================================
# NOTIFICAÇÕES DE ERRO (NOVO!)
# ========================================

# Número de WhatsApp do administrador para receber alertas de erro
# Formato: número com código do país, sem espaços ou caracteres especiais
# Exemplo: 5511999999999 (Brasil com DDD 11)
ADMIN_WHATSAPP_NUMBER=5511999999999


# ========================================
# CONFIGURAÇÕES DO BANCO DE DADOS
# ========================================

# Senha do usuário root do MySQL
MYSQL_ROOT_PASSWORD=sua_senha_root

# Nome do banco de dados
MYSQL_DATABASE=vendas_db

# Host do banco de dados (use 'db' no Docker Compose)
DB_HOST=db

# Porta do MySQL
DB_PORT=3306

# Usuário do banco de dados
DB_USER=root

# Senha do banco de dados (deve ser igual a MYSQL_ROOT_PASSWORD)
DB_PASSWORD=sua_senha_root

# Nome do banco de dados (deve ser igual a MYSQL_DATABASE)
DB_NAME=vendas_db


# ========================================
# CONFIGURAÇÕES DA OPENAI
# ========================================

# Chave de API da OpenAI para o agente de vendas
OPENAI_API_KEY=sk-proj-sua_chave_aqui


# ========================================
# CONFIGURAÇÕES DA APLICAÇÃO
# ========================================

# Ambiente de execução (development, staging, production)
FLASK_ENV=production

# Modo debug do Flask (True/False)
FLASK_DEBUG=False


# ========================================
# E-MAIL (Brevo API — brevo.com)
# ========================================

# API Key gerada em: brevo.com > SMTP & API > API Keys
BREVO_API_KEY=xkeysib-...

# E-mail remetente (deve estar cadastrado como Sender no Brevo)
EMAIL_FROM=paes@lsnlivros.com.br


# ========================================
# BB PIX API (extrato de PIX recebidos)
# ========================================

# Chave da aplicação no portal BB Developer
BB_PIX_APP_KEY=

# Credencial OAuth (campo "basic" do portal BB Developer, base64)
BB_PIX_CLIENT_BASIC=

# URLs da API (defaults já corretos para produção)
BB_PIX_API_URL=https://api-pix.bb.com.br/pix/v2
BB_PIX_OAUTH_URL=https://oauth.bb.com.br/oauth/token

# Caminhos dos certificados mTLS (mesmos do BB Pay, montados em /app/certs/)
BB_PIX_CERT_PEM=/app/certs/lsnlivros_chain.pem
BB_PIX_CERT_KEY=/app/certs/lsnlivros.key


# ========================================
# ORÇAMENTO — Google Sheets (Google Ads export)
# ========================================

# ID da planilha do Google Ads (único, fixo para todos os produtos)
ORCAMENTO_SHEETS_ID=1akHta9uSUfdMdYDXPWpLCtSp6sdvP8YkeeaoiT9b3yo

# Service Account com acesso de leitura à planilha acima
# Mesma variável usada para exportação de GCLIDs (produto 8)
# GOOGLE_SA_JSON_P8={"type":"service_account",...}


# ========================================
# INSTRUÇÕES DE USO
# ========================================

# 1. Copie este arquivo para .env:
#    cp .env.example .env

# 2. Preencha todas as variáveis com seus valores reais

# 3. NUNCA faça commit do arquivo .env (ele está no .gitignore)

# 4. No servidor de produção, crie o .env manualmente com as credenciais reais

# 5. Para testar notificações de erro, execute:
#    python scripts/exemplo_notificacoes.py
